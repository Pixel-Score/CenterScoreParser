          "offset": "1661"
        },
        {
          "type": "string_default",
          "key": "$Travis",
          "default": "Travis",
          "slot": "-1",
          "offset": "1670"
        },
        {
          "type": "title_card",
          "title": "Taylor's Gossip Files",
          "subtitle": "Are you ready to find out the secrets of Centerscore High?",
          "asset_id": "1078",
          "flag": "-1",
          "section_start": true,
          "offset": "1682"
        },
        {
          "type": "background",
          "style": "standard",
          "asset_id": "1015",
          "variant": "1",
          "offset": "1692"
        },
        {
          "type": "narration",
          "text": "One night, Erik and Justin are up late. Justin types on his laptop while Erik watches.",
          "character_id": "3",
          "expression": "0",
          "offset": "1699"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": "1",
          "image": "26061",
          "text": "I'm not sure we should be doing this...",
          "character_id": "1",
          "expression": "4",
          "offset": "1708"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": null,
          "image": "26060",
          "text": "Come on, aren't you curious to see what Taylor knows about everyone?",
          "character_id": "2",
          "offset": "1717"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": null,
          "image": "26060",
          "text": "I heard she digitized her entire gossip files and burned the actual book to 'keep it safe'...",
          "character_id": "2",
          "offset": "1726"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": "2",
          "image": "26062",
          "text": "As though there's a computer I couldn't hack into!",
          "character_id": "2",
          "expression": "2",
          "offset": "1735"
        },
        {
          "type": "dialogue",
          "speaker": "Erik",
          "emotion_code": null,
          "image": "26055",
          "text": "But... What if it says something bad about us?",
          "character_id": "1",
          "offset": "1742"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": "1",
          "image": "26061",
          "text": "I don't care what it says about `us.` I want to know what's really going on at our school!",
          "character_id": "2",
          "expression": "1",
          "offset": "1751",
          "text_bbcode": "I don't care what it says about [color=#e23b3b][i]us.[/i][/color] I want to know what's really going on at our school!"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": "2",
          "image": "26062",
          "text": "There! I've got it!",
          "character_id": "2",
          "expression": "2",
          "offset": "1760"
        },
        {
          "type": "dialogue",
          "speaker": "Erik",
          "emotion_code": "4",
          "image": "26059",
          "text": "That was fast. You must know a lot about computers.",
          "character_id": "1",
          "expression": "4",
          "offset": "1769"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": null,
          "image": "26060",
          "text": "When I was seven, I asked my parents for a puppy. They bought me a laptop.",
          "character_id": "2",
          "offset": "1778"
        },
        {
          "type": "dialogue",
          "speaker": "Erik",
          "emotion_code": "2",
          "image": "26057",
          "text": "Did you use it to look up videos of puppies?",
          "character_id": "1",
          "expression": "2",
          "offset": "1787"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": "3",
          "image": "26063",
          "text": "Every single day.",
          "character_id": "2",
          "expression": "3",
          "offset": "1796"
        },
        {
          "type": "dialogue",
          "speaker": "Justin",
          "emotion_code": null,
          "image": "26060",
          "text": "Anyway, now that we're in, let's see what Taylor has to say about...",
          "character_id": "2",
          "offset": "1805"
        },
        {
          "type": "var_set",
          "var": "2000",
          "value": 0,
          "offset": "1824"
        },
        {
          "type": "var_set",
          "var": "2001",
          "value": 0,
          "offset": "1831"
        },
