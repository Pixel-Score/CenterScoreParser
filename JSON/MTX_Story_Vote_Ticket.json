        },
        {
          "type": "dialogue",
          "speaker": "Terra",
          "emotion_code": "3",
          "image": "26057",
          "text": "Admiral Gosschalk was the best cadet ever to graduate from Astrocademy, and you know what happened to him when he traveled to the Outer Void...",
          "character_id": "8",
