        },
        {
          "type": "narration",
          "text": "Would you like to hone your magical abilities and become a powerful `witch` or `wizard?`",
          "character_id": "9",
          "expression": "0",
          "offset": "4111",
          "text_bbcode": "Would you like to hone your magical abilities and become a powerful [b]witch[/b] or [b]wizard?[/b]"
