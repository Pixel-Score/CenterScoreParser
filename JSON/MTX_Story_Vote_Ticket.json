          "index": "4",
          "offset": "4101"
        },
        {
          "type": "narration",
          "text": "Would you like to hone your magical abilities and become a powerful `witch` or `wizard?`",
          "character_id": "9",
          "expression": "0",
          "offset": "4111",
          "text_bbcode": "Would you like to hone your magical abilities and become a powerful [b]witch[/b] or [b]wizard?[/b]"
        },
        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "1",
          "image": "26025",
          "text": "There's no room for excuses, Athena!",
          "character_id": "3",
          "expression": "1",
          "offset": "4120"
        },
        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "1",
          "image": "26025",
          "text": "If you couldn't control your magic, you never would've survived the Ordeal of Admittance and been accepted into this school!",
          "character_id": "3",
          "expression": "1",
          "offset": "4129"
        },
        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "1",
          "image": "26025",
          "text": "The Necromancers are on the move! You must be ready!",
          "character_id": "3",
          "expression": "1",
          "offset": "4138"
        },
        {
          "type": "dialogue",
          "speaker": "Athena",
          "emotion_code": "3",
          "image": "26032",
          "text": "I know... I'm not trying to screw up, but every time I use my magic, something goes wrong.",
          "character_id": "4",
          "expression": "3",
          "offset": "4147"
        },
        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "3",
          "image": "26027",
          "text": "Oh dear, I was afraid of this... Sometimes powerful emotions can short-circuit magical ability...",
          "character_id": "3",
          "expression": "3",
          "offset": "4156"
        },
        {
          "type": "set_scene_value",
