        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "1",
          "image": "26025",
          "text": "There's no room for excuses, Athena!",
          "character_id": "3",
          "expression": "1",
          "offset": "4120"
        },
        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "1",
          "image": "26025",
          "text": "If you couldn't control your magic, you never would've survived the Ordeal of Admittance and been accepted into this school!",
          "character_id": "3",
          "expression": "1",
          "offset": "4129"
        },
        {
          "type": "dialogue",
          "speaker": "Professor Au Fait",
          "emotion_code": "1",
          "image": "26025",
          "text": "The Necromancers are on the move! You must be ready!",
          "character_id": "3",
          "expression": "1",
          "offset": "4138"
        },
        {
          "type": "dialogue",
          "speaker": "Athena",
          "emotion_code": "3",
          "image": "26032",
          "text": "I know... I'm not trying to screw up, but every time I use my magic, something goes wrong.",
