        },
        {
          "type": "narration",
          "text": "`GENRE #1: VAMPIRES!`",
          "character_id": "9",
          "expression": "0",
          "offset": "3966",
          "text_bbcode": "[b]GENRE #1: VAMPIRES![/b]"
